{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file (C++17)",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",                      // Enable C++17 (includes C++11 features)
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task updated for C++17 and g++ compiler"
        }
    ],
    "version": "2.0.0"
}
